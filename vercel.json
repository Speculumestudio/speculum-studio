{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.speculumstudio.com"
        }
      ],
      "destination": "https://speculumstudio.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ]
}
